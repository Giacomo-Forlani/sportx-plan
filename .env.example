# Required: set a strong, unique value in Dokploy > Environment.
# Generate one locally with: openssl rand -hex 32
# An empty value intentionally prevents deployment.
POSTGRES_PASSWORD=

# Optional: enable authenticated remote MCP at /mcp (32+ random bytes recommended).
# Leave unset to use only personal tokens, if configured. Never commit a real token.
SPORTX_MCP_TOKEN=

# Optional: private conversation directory (one personal token per developer).
# JSON object keyed by stable developer ID. See README for the format.
SPORTX_CONVERSATION_MEMBERS=
